# ============================================================
#  Kompas — konfiguracja dostawców danych
#  Skopiuj ten plik jako ".env" i wklej swoje klucze.
#  Bez kluczy aplikacja działa na danych DEMO (provider "mock").
# ============================================================

# Port serwera (opcjonalnie)
PORT=3000

# --- Konta konsultantów (logowanie) ---
# Baza SQLite z kontami, sesjami i koszykami. Domyślnie ./data/kompas.db
# UWAGA przy hostingu: darmowy dysk Render jest efemeryczny — na wdrożeniu
# pilotażowym wskaż tu ścieżkę na dysku trwałym, inaczej konta znikną po redeployu.
DB_PATH=
# Ile dni ważna jest sesja po zalogowaniu (domyślnie 30)
SESSION_DAYS=30

# --- Limity czasu na zewnętrzne API ---
# Pojedyncze zapytanie do dostawcy (ms, domyślnie 15000) i łączny limit
# na jednego dostawcę, który robi kilka wywołań po kolei (domyślnie 25000).
# Po przekroczeniu wynik składamy z pozostałych źródeł zamiast kazać czekać.
HTTP_TIMEOUT_MS=15000
PROVIDER_TIMEOUT_MS=25000

# Ile konsultant CZEKA, zanim oddamy mu to, co już dojechało (domyślnie 2500).
# To nie jest limit dla dostawcy: kto nie zdąży, leci dalej do PROVIDER_TIMEOUT_MS
# i zapisuje się do cache, więc jego oferty wchodzą do NASTĘPNEGO wyszukiwania,
# a panel od razu mówi, że lista jest niepełna. Wartość dobierać pomiarem, nie
# na wyczucie — `npm run czasy` pokazuje czasy źródeł i ile kosztuje dany próg.
PROVIDER_SOFT_TIMEOUT_MS=2500

# --- Cache wyników wyszukiwania ---
# Ile milisekund wynik dla tych samych kryteriów jest podawany z pamięci
# (domyślnie 180000 = 3 min) i ile takich wyników trzymamy (domyślnie 200).
# Celowo krótko: ceny i dostępność się zmieniają, a konsultant nie może podać
# klientowi ceny sprzed pół godziny.
SEARCH_CACHE_TTL_MS=180000
SEARCH_CACHE_MAX=200

# --- Kurs EUR→PLN (oferty Hotelbeds są rozliczane w euro) ---
# Kurs pobierany z API NBP (tabela A) przy starcie i odświeżany co FX_REFRESH_MS.
# EUR_PLN_FALLBACK działa tylko wtedy, gdy NBP nie odpowie przy zimnym starcie.
# FX_MARKUP to narzut na kurs średni NBP (0.02 = +2%). Domyślnie 0 — kurs średni
# jest kursem referencyjnym, nie sprzedaży; ustawić, gdy poznamy realny przelicznik
# stosowany przez organizatora.
FX_REFRESH_MS=21600000
EUR_PLN_FALLBACK=4.3
FX_MARKUP=0

# Pierwsze konto administratora zakłada się z wiersza poleceń:
#   npm run user:add -- ty@biuro.pl "Twoje Imię" mocneHaslo123 admin
#
# Na hostingu bez konsoli (Render free) nie ma jak odpalić tego polecenia,
# więc konto startowe można podać w zmiennych. Zakłada się TYLKO przy pustej
# bazie — przy kolejnych startach jest ignorowane, więc zmiana hasła w panelu
# nie zostanie nadpisana. Na produkcji ustaw to w panelu hostingu, nie w repo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Hotelbeds APItude (środowisko testowe / sandbox) ---
# Rejestracja: https://developer.hotelbeds.com  ->  darmowe konto -> "APItude" -> klucz + secret
# Na start zostaw endpoint testowy. Produkcję włączysz później zmieniając HOTELBEDS_ENV na "prod".
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_ENV=test

# --- Ratehawk / Emerging Travel Group (opcjonalnie, druga faza) ---
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=

# --- TravelLead.pl (program afiliacyjny Wakacje.pl) — NIEAKTYWNE ---
# Zgłoszenie odrzucone 28.07.2026 (nie współpracują z agregatami ofert).
# Pola zostają na wypadek innego ułożenia współpracy; puste = provider wyłączony.
TRAVELLEAD_FEED_URL=
TRAVELLEAD_PARTNER_ID=

# --- MerlinX (system agencyjny; wymaga konta agencyjnego) ---
MERLINX_URL=
MERLINX_LOGIN=
MERLINX_PASSWORD=
MERLINX_SYSTEM=
