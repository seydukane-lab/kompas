node_modules/
# Wszystkie warianty .env — sam ".env" NIE łapie kopii typu .env.bak czy .env.local,
# a takie pliki powstają przy podmianie kluczy i zawierają dokładnie te same sekrety.
# Wyjątkiem jest .env.example, który jest szablonem bez wartości i ma zostać w repo.
.env*
!.env.example
*.log
.DS_Store

# Baza kont konsultantów (hashe haseł, sesje, koszyki) — NIGDY do repo.
data/

# Provider LOKALNY (nieoficjalny endpoint wakacje.pl) — NIGDY na publiczne repo.
# Włącza się tylko lokalnie przez WAKACJE_API_URL/KEY w .env.
src/providers/wakacje.js

# Zdjęcia inspiracji (prywatne screeny monitora z pracy) — tylko lokalnie.
inspiracje/

# Doradca ETA OS — prompt to know-how użytkownika (framework ETA OS™). LOKALNIE.
src/advisor.js
src/eta-os-prompt.js
